# Starts the VOICEVOX ENGINE voice-notify uses at logon
# (/voice-notify setup fills in {{…}}, puts it in ~/.config/systemd/user/ and enables it with systemctl --user enable --now)
[Unit]
Description=VOICEVOX ENGINE for voice-notify (Claude Code)

[Service]
WorkingDirectory={{DIR}}
ExecStart="{{RUN}}"
Restart=on-failure

[Install]
WantedBy=default.target
