      "音声通知を停止します。"
    ],
    "unmute": [
      "音声通知を再開します。"
    ]
  },
  "subagent": {
    "debounceSeconds": 8,
    "defaultLabel": "エージェント"
  },
  "speech": {
    "shortSentenceChars": 20,
    "maxTwoSentenceChars": 60,
    "briefMaxSeconds": 30,
    "readings": {
      "FIX": "フィックス",
      "TASK": "タスク",
      "DONE": "ダン",
      "STATUS": "ステータス",
      "NOTE": "ノート",
      "PASS": "パス",
      "FAIL": "フェイル",
      "TODO": "トゥードゥー",
      "README": "リードミー",
      "npm": "エヌピーエム",
      "pnpm": "ピーエヌピーエム",
      "npx": "エヌピーエックス",
      "tsc": "ティーエスシー",
      "json": "ジェイソン",
      "css": "シーエスエス",
      "url": "ユーアールエル",
      "cli": "シーエルアイ",
      "sdk": "エスディーケー",
      "api": "エーピーアイ",
      "jsx": "ジェイエスエックス",
      "tsx": "ティーエスエックス",
      "mcp": "エムシーピー",
      "llm": "エルエルエム",
      "utf": "ユーティーエフ"
    },
    "lowercaseMinLength": 5,
    "keepUppercase": [
      "HTTPS",
      "DPAPI"
    ],
    "summarize": true,
    "summarizeEvents": [
      "stop",
      "agentstop"
    ],
    "summaryModel": "haiku",
    "summaryMinChars": 80,
    "summaryMaxChars": 60,
    "interimMaxChars": 30,
    "interimPrompt": [
      "",
      "今回は途中経過なので、ひと言で報告します。「〜しました。」「〜中です。」のような1文だけ、{maxChars}文字以内で出力してください。コミットID・ファイル名・パスは聞いても分からないので含めず、数字や固有名詞は最も大事な1つだけ残してください。"
    ],
    "summaryTimeoutSec": 15,
    "summaryPrompt": [
      "次に示すのは、あなたが依頼者に向けて書いた作業報告です。",
      "いまから同じ内容を、作業した本人として口頭で報告します。",
      "聞き手に語りかける「です・ます」調で、日本語1〜2文・合計{maxChars}文字以内にしてください。",
      "数字や固有名詞など、聞いて役に立つ具体は残してください。",
      "",
      "相手の入力や判断を待っている内容のときだけ、最後に短く呼びかけてください",
      "（ご判断をお願いします／どちらにしましょうか／ご確認ください など）。",
      "待っていないときは呼びかけを付けず、報告だけで終えてください。",
      "",
      "例:",
      "  良い: 要約の生成が1秒を切りました。体感の待ち時間はなくなっています。",
      "  良い: 原因は compact の誤検知でした。開始を見ていない停止は無視するようにしています。",
      "  良い: テストが3件失敗しています。仕様の意図を確認したいので、ご判断をお願いします。",
      "  悪い: 要約処理の高速化とモデル選定を実施しました。",
      "  悪い: compact の誤検知について調査と修正を行いました。",
      "  悪い: 修正が完了しました。詳細は資料をご確認ください。",
      "",
      "報告文だけを出力し、前置き・記号・箇条書き・引用符は使わないでください。"
    ]
  },
  "mute": {
    "whenMicInUse": true
  },
  "cacheMaxFiles": 200,
  "playback": {
    "leadSilenceMs": 600
  },
  "notification": {
    "toolLabels": {
      "Bash": "コマンド実行",
      "Edit": "ファイル編集",
      "Write": "ファイル書き込み",
      "Read": "ファイル読み取り",
      "WebFetch": "ウェブ取得",
      "WebSearch": "ウェブ検索"
    }
  }
